CREATE OR REPLACE FUNCTION fn_tg_impedir_locacao_horario_conflitante()
RETURNS TRIGGER AS $$
DECLARE
    v_conflito INT;
BEGIN
    SELECT COUNT(*) INTO v_conflito
    FROM locacao
    WHERE id_quadra = NEW.id_quadra
      AND data_locacao = NEW.data_locacao
      AND status = 'Confirmada'
      AND (NEW.hora_inicio < hora_fim AND NEW.hora_fim > hora_inicio)
      AND (TG_OP = 'INSERT' OR id <> NEW.id);

    IF v_conflito > 0 THEN
        RAISE EXCEPTION 'Conflito de horário: Já existe uma locação confirmada para esta quadra neste intervalo.';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER tg_impedir_locacao_horario_conflitante
BEFORE INSERT OR UPDATE ON locacao
FOR EACH ROW
EXECUTE FUNCTION fn_tg_impedir_locacao_horario_conflitante();

CREATE OR REPLACE FUNCTION fn_tg_atualizar_status_aluno_inadimplente()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.status = 'Pendente' AND (CURRENT_DATE - NEW.data_vencimento) > 30 THEN
        UPDATE aluno 
        SET status = 'Inadimplente' 
        WHERE id = (SELECT id_aluno FROM matricula WHERE id = NEW.id_matricula);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER tg_atualizar_status_aluno_inadimplente
AFTER INSERT OR UPDATE ON mensalidade
FOR EACH ROW
EXECUTE FUNCTION fn_tg_atualizar_status_aluno_inadimplente();

CREATE OR REPLACE FUNCTION fn_tg_log_alteracao_valor_plano()
RETURNS TRIGGER AS $$
BEGIN
    IF OLD.valor <> NEW.valor OR OLD.descricao <> NEW.descricao THEN
        INSERT INTO auditoria_plano (id_plano, usuario, valor_antigo, valor_novo, descricao_antiga, descricao_nova)
        VALUES (OLD.id, current_user, OLD.valor, NEW.valor, OLD.descricao, NEW.descricao);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER tg_log_alteracao_valor_plano
AFTER UPDATE ON plano
FOR EACH ROW
EXECUTE FUNCTION fn_tg_log_alteracao_valor_plano();
